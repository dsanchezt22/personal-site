[Unit]
Description=Diego personal site preview
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/apps/personal-site
ExecStart=/usr/bin/python3 %h/apps/personal-site/server.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
